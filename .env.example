# Copia este archivo a .env. No subas .env al repositorio.
# Ruta absoluta al binario agy (`which agy`). Si se omite, se busca en PATH y en ~/.local/bin/agy.
AGY_BIN=
AGY_DEFAULT_MODEL=gemini-3.8-flash-high
# Segundos
AGY_TIMEOUT=600
# Opcional: accept-edits | auto | plan
AGY_MODE=
AGY_SANDBOX=false
# Solo "true" pasa --dangerously-skip-permissions (peligroso)
AGY_SKIP_PERMISSIONS=false
